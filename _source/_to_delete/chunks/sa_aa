/* ============================================================
   app.css — Hệ thống giao diện dùng chung
   ============================================================ */
:root {
  --navy: #1f3a5f;
  --navy-2: #16293f;
  --gold: #c8a24b;
  --gold-2: #b08d38;
  --ink: #1c2431;
  --muted: #667085;
  --line: #e6e8ee;
  --bg: #f4f6fa;
  --card: #ffffff;
  --ok: #1e9e6a;
  --shadow: 0 6px 22px rgba(20, 30, 50, 0.08);
  --radius: 14px;
}
* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }
body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue",
    Arial, "Noto Sans", "Liberation Sans", sans-serif;
  color: var(--ink);
  background: var(--bg);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}
a { color: var(--navy); text-decoration: none; }
a:hover { text-decoration: underline; }
.muted { color: var(--muted); }

/* Header / nav */
.site-header {
  background: linear-gradient(135deg, var(--navy) 0%, var(--navy-2) 100%);
  color: #fff;
  padding: 0;
  box-shadow: var(--shadow);
  position: sticky; top: 0; z-index: 1000;
}
.nav {
  max-width: 1280px; margin: 0 auto; padding: 12px 20px;
  display: flex; align-items: center; gap: 16px; flex-wrap: wrap;
}
.brand { display: flex; align-items: center; gap: 10px; font-weight: 800; font-size: 18px; color: #fff; }
.brand .dot { color: var(--gold); }
.brand:hover { text-decoration: none; }
.nav-links { display: flex; gap: 6px; margin-left: auto; flex-wrap: wrap; }
.nav-links a {
  color: #e8edf5; padding: 8px 14px; border-radius: 999px; font-weight: 600; font-size: 14px;
}
.nav-links a:hover { background: rgba(255,255,255,.12); text-decoration: none; }
.nav-links a.active { background: var(--gold); color: #241c05; }

/* Buttons & chips */
.btn {
  display: inline-flex; align-items: center; gap: 6px; cursor: pointer;
  border: 1px solid var(--line); background: #fff; color: var(--ink);
  padding: 7px 12px; border-radius: 999px; font-size: 13px; font-weight: 600;
  transition: .15s; white-space: nowrap;
}
.btn:hover { border-color: var(--navy); background: #f0f4fa; text-decoration: none; }
.btn.primary { background: var(--navy); color: #fff; border-color: var(--navy); }
.btn.primary:hover { background: var(--navy-2); }
.btn.gold { background: var(--gold); color: #241c05; border-color: var(--gold); }
.btn.gold:hover { background: var(--gold-2); }
.btn.sm { padding: 5px 10px; font-size: 12px; }
.btn.speaking { background: var(--gold); color: #241c05; border-color: var(--gold); animation: pulse 1.2s infinite; }
@keyframes pulse { 0%,100%{ box-shadow: 0 0 0 0 rgba(200,162,75,.5);} 50%{ box-shadow: 0 0 0 6px rgba(200,162,75,0);} }

.chip {
  display: inline-flex; align-items: center; gap: 5px;
  padding: 3px 10px; border-radius: 999px; font-size: 12px; font-weight: 600;
  color: #fff; white-space: nowrap;
}
.chip.ghost { background: #eef1f6; color: var(--muted); }
.badge-free { background: #e7f7ef; color: var(--ok); border: 1px solid #bfe9d3; padding: 2px 8px; border-radius: 999px; font-size: 11px; font-weight: 700; }
.badge-status { font-size: 11px; padding: 2px 8px; border-radius: 999px; font-weight: 700; }
.badge-status.enriched { background: #eaf2ff; color: #2f6fdb; }
.badge-status.verified { background: #e7f7ef; color: var(--ok); }
.badge-status.stub { background: #fff3e0; color: #b26a00; }

/* Stars */
.stars { color: var(--gold); letter-spacing: 1px; font-size: 15px; }
.stars.muted { color: var(--muted); font-size: 12px; letter-spacing: 0; }

/* Cards */
.container { max-width: 1280px; margin: 0 auto; padding: 20px; }
.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 18px; }
.card {
  background: var(--card); border: 1px solid var(--line); border-radius: var(--radius);
  overflow: hidden; box-shadow: var(--shadow); display: flex; flex-direction: column;
}
.card-photo {
  height: 168px; background: linear-gradient(135deg, #2b4a72, #16293f);
  background-size: cover; background-position: center; position: relative;
}
.card-photo .cat-tag {
  position: absolute; left: 10px; top: 10px;
}
.card-photo .ph-fallback {
  position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
  color: rgba(255,255,255,.85); font-size: 40px;
}
.card-body { padding: 14px 16px 16px; display: flex; flex-direction: column; gap: 8px; }
.card h3 { margin: 0; font-size: 17px; line-height: 1.35; }
.card .subname { color: var(--muted); font-size: 12.5px; margin-top: -2px; }
.rating-row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; font-size: 13px; }
.short { font-size: 14px; color: #35404f; }
.card-actions { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 4px; }
.detail { display: none; border-top: 1px dashed var(--line); margin-top: 6px; padding-top: 10px; font-size: 14px; }
.detail.open { display: block; }
.detail h4 { margin: 12px 0 4px; font-size: 13px; text-transform: uppercase; letter-spacing: .04em; color: var(--navy); }
.detail ul { margin: 4px 0; padding-left: 18px; }
.detail .practical { display: grid; grid-template-columns: 1fr; gap: 4px; font-size: 13.5px; }
.detail .practical b { color: var(--navy); }

/* Toolbar / filters */
.toolbar {
  background: #fff; border: 1px solid var(--line); border-radius: var(--radius);
  padding: 12px 14px; box-shadow: var(--shadow); margin-bottom: 18px;
  display: flex; gap: 10px; align-items: center; flex-wrap: wrap;
}
.toolbar input[type="search"], .toolbar select {
  border: 1px solid var(--line); border-radius: 10px; padding: 8px 12px; font-size: 14px; font-family: inherit;
}
.toolbar input[type="search"] { min-width: 220px; flex: 1; }
.filter-cats { display: flex; gap: 6px; flex-wrap: wrap; }
.filter-cats .fc {
  cursor: pointer; user-select: none; padding: 4px 10px; border-radius: 999px;
  border: 1.5px solid var(--line); font-size: 12.5px; font-weight: 600; color: var(--muted);
}
.filter-cats .fc.on { color: #fff; border-color: transparent; }

/* Footer */
.site-footer {
  margin-top: 40px; background: var(--navy-2); color: #cdd7e6; padding: 26px 20px;
}
.site-footer .fwrap { max-width: 1280px; margin: 0 auto; display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
.site-footer a { color: var(--gold); }
.site-footer .contact b { color: #fff; }

/* Hero (index) */
.hero {
  background: linear-gradient(135deg, var(--navy) 0%, var(--navy-2) 100%);
  color: #fff; padding: 54px 20px;
}
.hero .hwrap { max-width: 1100px; margin: 0 auto; }
.hero h1 { font-size: 34px; margin: 0 0 10px; line-height: 1.2; }
.hero p.lead { font-size: 17px; color: #dbe4f0; max-width: 760px; }
.hero .cta { display: flex; gap: 12px; margin-top: 22px; flex-wrap: wrap; }
.stats { display: flex; gap: 26px; margin-top: 26px; flex-wrap: wrap; }
.stat b { display: block; font-size: 30px; color: var(--gold); }
.stat span { font-size: 13px; color: #cdd7e6; }

.notice { background: #fff8e6; border: 1px solid #f0d98a; color: #6b551a; padding: 10px 14px; border-radius: 10px; font-size: 13.5px; }

@media (max-width: 640px) {
  .hero h1 { font-size: 26px; }
  .nav-links { width: 100%; margin-left: 0; }
}


