thú vị là vé tham quan bao gồm một phần kem từ 'nhà máy kem cao nhất thế giới' ngay trên đài, cùng bảo tàng kem và nhà hàng xoay '360'. Đây là trải nghiệm hiện đại, sang trọng, đặc biệt lung linh khi màn đêm buông xuống và cả thành phố lên đèn. Tuy giá vé không rẻ và tầm nhìn phụ thuộc thời tiết, khung cảnh từ độ cao này vẫn là một trong những điều đáng nhớ nhất ở Moskva.", "highlights_vi": ["Đài quan sát cao nhất châu Âu ở tầng 89, độ cao 327 m, tầm nhìn 360 độ", "Kem miễn phí từ 'nhà máy kem cao nhất thế giới' kèm trong vé tham quan", "Rừng nhà chọc trời Moskva-City lung linh soi bóng bên sông Moskva"], "practical": {"hours_vi": "Hàng ngày 10:00–22:00.", "ticket_vi": "Giá tại quầy khoảng 2.900 ₽; đặt online theo khung giờ có thể còn 1.000–2.000 ₽; vé kèm một phần kem.", "duration_vi": "Khoảng 1–1,5 giờ.", "best_time_vi": "Ngày trời trong; canh hoàng hôn để ngắm cả cảnh ban ngày lẫn thành phố lên đèn.", "tips_vi": "Đi metro đến ga Vystavochnaya hoặc Delovoy Tsentr; mua vé online theo suất giờ để được giá tốt và tránh xếp hàng."}, "photo": "https://commons.wikimedia.org/wiki/Special:FilePath/Moscow-City%20skyline.jpg", "photo_credit": "Wikimedia Commons", "maps": {"yandex": "https://yandex.com/maps/?pt=37.537139,55.749769&z=17&l=map", "google": "https://www.google.com/maps/search/?api=1&query=55.749769,37.537139"}, "official_site": "https://pnr360.ru/en/", "sources": [{"title": "Wikipedia (EN)", "url": "https://en.wikipedia.org/wiki/Special:Search?search=Moscow%20City%20%26%20Panorama%20360%20observation%20deck%20%28Federation%20Tower%29"}], "tags": ["viewpoint", "observation-deck", "skyscraper", "business-district", "modern", "ticketed"], "status": "enriched", "last_updated": "2026-07-16"}, {"id": "moscow-alexander-garden", "slug": "alexander-garden", "region": "moscow", "region_name_vi": "Moskva", "federal_district": "Thành phố trực thuộc liên bang", "name_vi": "Vườn Alexander & Mộ Chiến sĩ Vô danh (A-lếch-xan-đrốp-xki Sát)", "name_ru": "Александровский сад", "name_en": "Alexander Garden (with the Tomb of the Unknown Soldier)", "categories": ["park_garden", "monument"], "coordinates": {"lat": 55.7525, "lon": 37.61389}, "address_vi": "Vườn Alexander, dọc tường phía tây điện Kremlin, trung tâm Moskva, Nga", "rating": {"value": 4.4, "count": 637, "source": "Tripadvisor", "as_of": "2026-07"}, "review_summary_vi": "Mộ Chiến sĩ Vô danh đạt khoảng 4,4/5 với hơn 630 lượt đánh giá trên Tripadvisor. Du khách xúc động trước không khí trang nghiêm, ngọn lửa vĩnh cửu và nghi thức đổi gác; một số lưu ý đám đông có thể che khuất tầm nhìn vào giờ đổi gác.", "presentation_short_vi": "Vườn Alexander (Aleksandrovsky Sad) là công viên thanh bình trải dọc bức tường phía tây điện Kremlin. Nơi đây có Mộ Chiến sĩ Vô danh với ngọn lửa vĩnh cửu và nghi thức đổi gác trang nghiêm diễn ra mỗi giờ.", "presentation_long_vi": "Nằm nép mình dọc bức tường phía tây điện Kremlin, Vườn Alexander là một trong những không gian xanh lâu đời và được yêu mến nhất Moskva. Được kiến tạo trong các năm 1819–1823 theo lệnh Sa hoàng Aleksandr I sau chiến thắng trước Napoléon, khu vườn trải dài 865 m, chia thành ba phần với những lối đi rợp bóng cây, luống hoa rực rỡ và các đài phun nước. Trái tim thiêng liêng của khu vườn là Mộ Chiến sĩ Vô danh, khánh thành năm 1967 để tưởng nhớ những người lính đã ngã xuống trong Chiến tranh Vệ quốc Vĩ đại. Trên phiến đá granite đỏ đặt chiếc mũ sắt và lá cờ bằng đồng, còn ngọn lửa vĩnh cửu cháy không ngừng – được rước về từ Cánh đồng Sao Hỏa ở Leningrad. Bên cạnh là đội tiêu binh danh dự đứng gác, và cứ mỗi giờ lại diễn ra nghi thức đổi gác chính xác đến từng động tác, thu hút đông đảo người xem. Dạo bước trong vườn, du khách còn bắt gặp hang động nhân tạo dưới Tháp Kho vũ khí Giữa, đài phun nước ngựa và các bức tượng nhân vật cổ tích ở đầu vườn giáp Quảng trường Manezhnaya. Đây là nơi lý tưởng để nghỉ chân, kết nối liền mạch giữa Quảng trường Đỏ, điện Kremlin và trung tâm thành phố.", "highlights_vi": ["Mộ Chiến sĩ Vô danh với ngọn lửa vĩnh cửu cháy suốt ngày đêm", "Nghi thức đổi gác của đội tiêu binh danh dự diễn ra mỗi giờ", "Lối đi rợp bóng cây, đài phun nước và tượng nhân vật cổ tích ven vườn"], "practical": {"hours_vi": "Khu vườn mở cửa hàng ngày (tự do); nghi thức đổi gác diễn ra mỗi giờ.", "ticket_vi": "Miễn phí.", "duration_vi": "Khoảng 30–60 phút.", "best_time_vi": "Buổi sáng hoặc cuối chiều; canh đúng đầu giờ để xem đổi gác.", "tips_vi": "Ga metro Aleksandrovsky Sad hoặc Okhotny Ryad ngay cạnh; giữ thái độ trang nghiêm tại đài tưởng niệm và đến sớm vài phút để có chỗ xem đổi gác."}, "photo": "https://commons.wikimedia.org/wiki/Special:FilePath/Alexander%20Garden%2C%20Moscow.jpg", "photo_credit": "Wikimedia Commons", "maps": {"yandex": "https://yandex.com/maps/?pt=37.61389,55.7525&z=17&l=map", "google": "https://www.google.com/maps/search/?api=1&query=55.7525,37.61389"}, "official_site": null, "sources": [{"title": "Wikipedia (EN)", "url": "https://en.wikipedia.org/wiki/Special:Search?search=Alexander%20Garden%20%28with%20the%20Tomb%20of%20the%20Unknown%20Soldier%29"}], "tags": ["park", "war-memorial", "eternal-flame", "changing-of-the-guard", "free", "outdoor"], "status": "enriched", "last_updated": "2026-07-16"}, {"id": "moscow-patriarchs-ponds", "slug": "patriarchs-ponds", "region": "moscow", "region_name_vi": "Moskva", "federal_district": "Thành phố trực thuộc liên bang", "name_vi": "Ao Thượng Phụ (Pa-tri-ác-si-e Pru-đư)", "name_ru": "Патриаршие пруды", "name_en": "Patriarch's Ponds (Patriarshiye Prudy)", "categories": ["park_garden", "other"], "coordinates": {"lat": 55.763883, "lon": 37.59212}, "address_vi": "Ao Thượng Phụ, phố Malaya Bronnaya, Quận Presnensky, trung tâm Moskva, Nga", "rating": {"value": 4.5, "count": 780, "source": "Tripadvisor", "as_of": "2026-07"}, "review_summary_vi": "Ao Thượng Phụ đạt khoảng 4,5/5 với gần 780 lượt đánh giá trên Tripadvisor. Du khách yêu thích khung cảnh yên bình, thơ mộng và ý nghĩa văn học; một số cho rằng bản thân cái hồ khá bình thường và khu vực hơi 'kiểu cách', đông vào cuối tuần.", "presentation_short_vi": "Ao Thượng Phụ (đọc là 'Pa-tri-ác-si-e Pru-đư') là hồ nước thanh bình giữa khu phố quý phái Presnensky. Nơi đây nổi tiếng là bối cảnh mở đầu tiểu thuyết 'Nghệ nhân và Margarita' của Mikhail Bulgakov.", "presentation_long_vi": "Ẩn mình giữa những con phố yên tĩnh và sang trọng bậc nhất Moskva, Ao Thượng Phụ là một góc lãng mạn được giới văn nghệ sĩ và người dân thủ đô đặc biệt yêu mến. Hồ nước hình chữ nhật được đào từ đầu thế kỷ 19, bao quanh là hàng cây rợp bóng, ghế đá và những lối đi thư thái – nơi các cặp đôi dạo bước, người ta dắt chó đi chơi và ngồi ngắm thiên nga vào mùa hè. Nhưng điều khiến nơi đây trở nên bất tử chính là văn chương: Ao Thượng Phụ là bối cảnh mở màn kiệt tác 'Nghệ nhân và Margarita' của Mikhail Bulgakov, khi nhân vật quỷ Woland xuất hiện và tiên đoán cái chết kỳ lạ bên hồ. Chính Bulgakov cũng từng sống gần đây trong thập niên 1930. Ngày nay, du khách yêu sách thường tìm đến để hình dung lại những trang viết ma mị và chụp ảnh bên khung cảnh quen thuộc. Vào mùa đông, mặt hồ đóng băng biến thành sân trượt patin duyên dáng. Dù bản thân cái hồ không quá hoành tráng, chính bầu không khí tĩnh lặng, những quán cà phê thời thượng quanh đó và sức nặng văn hóa đã làm nên sức hút riêng cho Ao Thượng Phụ.", "highlights_vi": ["Bối cảnh mở đầu tiểu thuyết 'Nghệ nhân và Margarita' của Bulgakov", "Không gian hồ nước tĩnh lặng rợp bóng cây giữa khu phố quý phái", "Quán cà phê thời thượng bao quanh và sân trượt băng vào mùa đông"], "practical": {"hours_vi": "Mở cửa tự do (là quảng trường/công viên công cộng).", "ticket_vi": "Miễn phí.", "duration_vi": "Khoảng 30–45 phút.", "best_time_vi": "Cuối chiều mùa hè để đi dạo, hoặc mùa đông khi hồ thành sân trượt băng.", "tips_vi": "Ga metro gần nhất là Mayakovskaya; kết hợp ngồi một quán cà phê ven hồ và mang theo cuốn 'Nghệ nhân và Margarita' để cảm nhận trọn vẹn."}, "photo": "https://commons.wikimedia.org/wiki/Special:FilePath/Patriarshii-prudy2012.JPG", "photo_credit": "Wikimedia Commons", "maps": {"yandex": "https://yandex.com/maps/?pt=37.59212,55.763883&z=17&l=map", "google": "https://www.google.com/maps/search/?api=1&query=55.763883,37.59212"}, "official_site": null, "sources": [{"title": "Wikipedia (EN)", "url": "https://en.wikipedia.org/wiki/Special:Search?search=Patriarch%27s%20Ponds%20%28Patriarshiye%20Prudy%29"}], "tags": ["pond", "literary", "bulgakov", "quiet", "free", "outdoor"], "status": "enriched", "last_updated": "2026-07-16"}, {"id": "moscow-manezhnaya-square", "slug": "manezhnaya-square", "region": "moscow", "region_name_vi": "Moskva", "federal_district": "Thành phố trực thuộc liên bang", "name_vi": "Quảng trường Manezhnaya (Ma-nhe-giơ-na-ia)", "name_ru": "Манежная площадь", "name_en": "Manezhnaya Square (Manege Square)", "categories": ["square_street", "other"], "coordinates": {"lat": 55.75583, "lon": 37.61472}, "address_vi": "Quảng trường Manezhnaya, trung tâm Moskva (cạnh Quảng trường Đỏ), Nga", "rating": {"value": 4.3, "count": 275, "source": "Tripadvisor", "as_of": "2026-07"}, "review_summary_vi": "Quảng trường Manezhnaya đạt khoảng 4,3/5 với gần 275 lượt đánh giá trên Tripadvisor. Du khách khen vị trí trung tâm, đài phun nước và đặc biệt là khung cảnh trang trí, ánh đèn dịp lễ hội; điểm trừ là khá bình thường vào những thời điểm khác trong năm và thường rất đông người.", "presentation_short_vi": "Quảng trường Manezhnaya (đọc là 'Ma-nhe-giơ-na-ia') là quảng trường rộng lớn ngay sát Quảng trường Đỏ và Vườn Alexander. Nơi đây nổi bật với đài phun nước, tượng nhân vật cổ tích và mái vòm kính của trung tâm mua sắm ngầm Okhotny Ryad.", "presentation_long_vi": "Chỉ cách Quảng trường Đỏ vài bước chân, Quảng trường Manezhnaya là một trong những không gian mở nhộn nhịp và trung tâm nhất Moskva. Mang tên tòa nhà Manezh (trường cưỡi ngựa cũ) kề bên, quảng trường được mở rộng và định hình như ngày nay vào năm 1932. Năm 1997, khu vực này được cải tạo ngoạn mục với trung tâm thương mại ngầm Okhotny Ryad bốn tầng nằm bên dưới, phía trên là mái vòm kính lớn xoay tròn đóng vai trò 'đồng hồ thế giới' của Bắc bán cầu, đỉnh vòm gắn tượng Thánh George đâm rồng – biểu tượng của Moskva. Dọc rìa quảng trường giáp Vườn Alexander là dòng suối nhân tạo uốn lượn với hàng loạt đài phun nước và tượng đồng khắc họa các nhân vật trong truyện cổ tích Nga, nơi trẻ em và du khách thích thú chụp ảnh. Đây cũng là địa điểm quen thuộc tổ chức các lễ hội, hội chợ và trang trí rực rỡ mỗi dịp Năm Mới, khi cả quảng trường ngập trong ánh đèn lộng lẫy. Nhờ vị trí đắc địa, Manezhnaya trở thành điểm khởi đầu lý tưởng để khám phá trung tâm lịch sử: từ đây bạn có thể thong dong bước sang Quảng trường Đỏ, Vườn Alexander hay dạo phố mua sắm dưới lòng đất.", "highlights_vi": ["Mái vòm kính xoay với tượng Thánh George đâm rồng trên đỉnh", "Dòng suối, đài phun nước và tượng nhân vật cổ tích Nga ven Vườn Alexander", "Trung tâm mua sắm ngầm Okhotny Ryad ngay bên dưới quảng trường"], "practical": {"hours_vi": "Quảng trường mở cửa tự do; trung tâm mua sắm ngầm Okhotny Ryad theo giờ riêng (thường 10:00–22:00).", "ticket_vi": "Miễn phí (quảng trường).", "duration_vi": "Khoảng 30–45 phút.", "best_time_vi": "Buổi tối hoặc dịp lễ, đặc biệt Năm Mới khi quảng trường trang trí rực rỡ.", "tips_vi": "Ga metro Okhotny Ryad, Teatralnaya hoặc Ploshchad Revolyutsii ngay bên dưới; kết hợp tham quan liền mạch với Quảng trường Đỏ và Vườn Alexander."}, "photo": "https://commons.wikimedia.org/wiki/Special:FilePath/Manege%20square.jpg", "photo_credit": "Wikimedia Commons", "maps": {"yandex": "https://yandex.com/maps/?pt=37.61472,55.75583&z=17&l=map", "google": "https://www.google.com/maps/search/?api=1&query=55.75583,37.61472"}, "official_site": null, "sources": [{"title": "Wikipedia (EN)", "url": "https://en.wikipedia.org/wiki/Special:Search?search=Manezhnaya%20Square%20%28Manege%20Square%29"}], "tags": ["square", "fountains", "shopping", "central", "free", "outdoor"], "status": "enriched", "last_updated": "2026-07-16"}, {"id": "moscow-danilov-monastery", "slug": "danilov-monastery", "region": "moscow", "region_name_vi": "Moskva", "federal_district": "Thành phố trực thuộc liên bang", "name_vi": "Tu viện Danilov (Đa-ni-lốp)", "name_ru": "Свято-Данилов монастырь", "name_en": "Danilov Monastery", "categories": ["church"], "coordinates": {"lat": 55.71111, "lon": 37.62917}, "address_vi": "Phố Danilovsky Val 22, Moskva, Nga", "rating": {"value": 4.5, "count": 74, "source": "Tripadvisor", "as_of": "2026-07"}, "review_summary_vi": "Với khoảng 74 lượt đánh giá trên Tripadvisor (4,5/5), du khách khen ngợi bầu không khí trang nghiêm, tiếng thánh ca ngân nga và những ổ bánh do chính tu viện làm ra. Một số ý kiến phàn nàn về khu công nghiệp lân cận, công trình đang thi công và cảnh chen chúc vào dịp lễ.", "presentation_short_vi": "Tu viện Danilov là tu viện lâu đời nhất Moskva, do hoàng thân Daniil sáng lập vào cuối thế kỷ 13. Ngày nay đây là trung tâm hành chính - tinh thần của Giáo hội Chính thống Nga và là nơi đặt tòa của Đức Thượng phụ cùng Thánh Công đồng.", "presentation_long_vi": "Nằm bên hữu ngạn sông Moskva, Tu viện Danilov được xem là tu viện lâu đời nhất thủ đô, gắn với tên tuổi hoàng thân Daniil xứ Moskva – con trai út của danh tướng Aleksandr Nevsky. Theo truyền thuyết, ngài lập tu viện vào cuối thế kỷ 13, rồi khấn dòng trước khi qua đời năm 1303 và về sau được tôn phong hiển thánh. Trải qua nhiều thăng trầm, thậm chí bị đóng cửa và biến thành trại giam thời Xô Viết, quần thể được trao lại cho Giáo hội năm 1983 và trở thành nơi đặt tòa của Đức Thượng phụ cùng Thánh Công đồng. Sau bức tường trắng cùng những tháp canh cổ kính là một không gian tĩnh lặng đến bất ngờ giữa lòng đô thị ồn ào: Nhà thờ chính tòa Các Thánh Giáo phụ của Bảy Công đồng Đại kết với ba tầng thánh đường xếp chồng độc đáo, và Nhà thờ Chúa Ba Ngôi mang phong cách tân cổ điển thanh thoát. Du khách còn được nghe kể về bộ chuông trứ danh của tu viện – bộ chuông từng lưu lạc sang Đại học Harvard và mãi đến năm 2008 mới trở về. Với tín hữu Chính thống giáo, đây là chốn hành hương thiêng liêng; còn với lữ khách phương xa, đó là cánh cửa mở vào chiều sâu lịch sử và tâm hồn nước Nga.", "highlights_vi": ["Tu viện Chính thống giáo cổ nhất Moskva, nơi đặt tòa của Đức Thượng phụ và Thánh Công đồng.", "Nhà thờ Các Thánh Giáo phụ của Bảy Công đồng Đại kết với ba thánh đường xếp chồng lên nhau.", "Bộ chuông cổ nổi tiếng từng lưu lạc sang Harvard và được đưa trở về năm 2008."], "practical": {"hours_vi": "Khuôn viên mở cửa hằng ngày, khoảng 6:00–21:00; giờ lễ sáng và chiều theo lịch phụng vụ.", "ticket_vi": "Miễn phí.", "duration_vi": "Khoảng 1–1,5 giờ.", "best_time_vi": "Buổi sáng ngày thường để tránh đông và cảm nhận sự tĩnh lặng.", "tips_vi": "Nữ giới nên mang khăn trùm đầu và mặc váy dài, ăn mặc kín đáo khi vào thánh đường. Đừng bỏ lỡ quầy bánh mì của tu viện gần cổng."}, "photo": "https://commons.wikimedia.org/wiki/Special:FilePath/Danilov%20Monastery%20Moscow%2005-2017%20img10%20Danilov%20Monastery.jpg", "photo_credit": "Wikimedia Commons", "maps": {"yandex": "https://yandex.com/maps/?pt=37.62917,55.71111&z=17&l=map", "google": "https://www.google.com/maps/search/?api=1&query=55.71111,37.62917"}, "official_site": "https://msdm.ru/", "sources": [{"title": "Wikipedia (EN)", "url": "https://en.wikipedia.org/wiki/Special:Search?search=Danilov%20Monastery"}], "tags": ["church", "monastery", "orthodox", "free", "history"], "status": "enriched", "last_updated": "2026-07-16"}, {"id": "moscow-donskoy-monastery", "slug": "donskoy-monastery", "region": "moscow", "region_name_vi": "Moskva", "federal_district": "Thành phố trực thuộc liên bang", "name_vi": "Tu viện Donskoy (Đôn-xkôi)", "name_ru": "Донской монастырь", "name_en": "Donskoy Monastery", "categories": ["church"], "coordinates": {"lat": 55.71444, "lon": 37.60208}, "address_vi": "Quảng trường Donskaya 1–3, Moskva, Nga", "rating": {"value": 4.8, "count": 294, "source": "Tripadvisor", "as_of": "2026-07"}, "review_summary_vi": "Đạt 4,8/5 với gần 300 lượt đánh giá trên Tripadvisor, Donskoy được khen là một trong những tu viện giàu không khí nhất Moskva, với tường thành, nghĩa trang cổ và khuôn viên yên bình. Nhiều du khách tiếc rằng công trình trùng tu kéo dài che khuất một số hạng mục và một phần khuôn viên bị hạn chế tham quan.", "presentation_short_vi": "Tu viện Donskoy được Sa hoàng Fyodor I lập năm 1591 để tạ ơn thoát khỏi cuộc vây hãm của quân Hãn Krym, mang tên bức linh ảnh Đức Mẹ sông Đông. Đây là một trong những tu viện - pháo đài đẹp và giàu chất thơ bậc nhất Moskva.", "presentation_long_vi": "Tu viện Donskoy ra đời năm 1591, khi Sa hoàng Fyodor I cho dựng đền tạ ơn Đức Mẹ vì đã giúp Moskva thoát khỏi đại quân của Hãn Krym Kazy-Girey. Tu viện mang tên bức linh ảnh Đức Mẹ sông Đông (Donskaya) – biểu tượng gắn với chiến thắng Kulikovo huyền thoại. Toàn bộ quần thể được ôm trọn trong vòng tường gạch đỏ - trắng theo phong cách baroque Moskva, điểm xuyết mười hai tòa tháp, khiến nơi đây trông vừa như thánh địa vừa như một pháo đài. Trung tâm là Nhà thờ Lớn năm mái vòm (1684–1698) với bàn thờ chạm khắc tám tầng lộng lẫy, đứng cạnh Nhà thờ Nhỏ khiêm nhường dựng từ năm 1593. Điều làm nên sức hút riêng của Donskoy chính là nghĩa trang cổ – nơi an nghỉ của giới quý tộc, văn nhân và nhiều nhân vật lịch sử Nga, trong đó có văn hào Aleksandr Solzhenitsyn. Tại đây còn lưu giữ những mảng phù điêu được cứu khỏi Nhà thờ Chúa Cứu Thế bị phá hủy thời Xô Viết, cùng phần mộ và thánh tích của Thượng phụ Tikhon. Dạo bước dưới những tán cây già, giữa các bia mộ chạm trổ tinh xảo, du khách như lạc vào một pho biên niên sử bằng đá của nước Nga.", "highlights_vi": ["Tường thành gạch đỏ - trắng cùng mười hai tháp canh theo phong cách baroque Moskva.", "Nhà thờ Lớn năm mái vòm với bàn thờ chạm khắc tám tầng và Nhà thờ Nhỏ có từ năm 1593.", "Nghĩa trang quý tộc lưu giữ mộ phần nhiều danh nhân Nga và các mảng phù điêu cứu từ Nhà thờ Chúa Cứu Thế."], "practical": {"hours_vi": "Khuôn viên mở cửa hằng ngày, khoảng 7:00–19:00; nghĩa trang thường đóng sớm hơn vào buổi chiều.", "ticket_vi": "Miễn phí (một số hoạt động chuyên đề có thể thu phí).", "duration_vi": "Khoảng 1,5–2 giờ.", "best_time_vi": "Ngày thường hoặc sáng cuối tuần, khi nắng làm nổi bật sắc tường đỏ - trắng.", "tips_vi": "Dành thời gian dạo nghĩa trang cổ phía sau nhà thờ; mang trang phục kín đáo và giày thoải mái vì khuôn viên khá rộng."}, "photo": "https://commons.wikimedia.org/wiki/Special:FilePath/Donskoj%20monastyr.JPG", "photo_credit": "Wikimedia Commons", "maps": {"yandex": "https://yandex.com/maps/?pt=37.60208,55.71444&z=17&l=map", "google": "https://www.google.com/maps/search/?api=1&query=55.71444,37.60208"}, "official_site": "https://donskoi.org/", "sources": [{"title": "Wikipedia (EN)", "url": "https://en.wikipedia.org/wiki/Special:Search?search=Donskoy%20Monastery"}], "tags": ["church", "monastery", "orthodox", "free", "history", "cemetery"], "status": "enriched", "last_updated": "2026-07-16"}, {"id": "moscow-andronikov-monastery", "slug": "andronikov-monastery", "region": "moscow", "region_name_vi": "Moskva", "federal_district": "Thành phố trực thuộc liên bang", "name_vi": "Tu viện Andronikov và Bảo tàng nghệ thuật Nga cổ Andrei Rublev (An-đrô-ni-cốp / An-đrây Ru-bli-ốp)", "name_ru": "Спасо-Андроников монастырь", "name_en": "Andronikov Monastery (Andrei Rublev Museum of Old Russian Art)", "categories": ["church", "museum"], "coordinates": {"lat": 55.74889, "lon": 37.67056}, "address_vi": "Quảng trường Andronyevskaya 10, Moskva, Nga", "rating": {"value": 4.9, "count": 76, "source": "Tripadvisor", "as_of": "2026-07"}, "review_summary_vi": "Với điểm 4,9/5 trên Tripadvisor, du khách ca ngợi sự tĩnh lặng, khuôn viên sạch đẹp và bộ sưu tập thánh tượng có giá trị lịch sử lớn. Một vài ý kiến nhận xét đôi chỗ tường vữa xuống cấp và quy định ra vào giữa khu tu viện với bảo tàng đôi khi gây bối rối.", "presentation_short_vi": "Tu viện Andronikov (thành lập năm 1357) lưu giữ Nhà thờ Chúa Cứu Thế – công trình bằng đá cổ nhất còn lại của Moskva – và gắn liền với danh họa vẽ thánh tượng Andrei Rublev. Trong khuôn viên nay là Bảo tàng Trung ương về Văn hóa và Nghệ thuật Nga cổ mang tên ông.", "presentation_long_vi": "Được Giáo trưởng Aleksy lập năm 1357 để tạ ơn thoát nạn giữa cơn bão biển, Tu viện Spaso-Andronikov là một trong những cái nôi tâm linh lâu đời nhất của Moskva. Vị viện trưởng đầu tiên, Thánh Andronik, là môn đệ của Thánh Sergiy xứ Radonezh. Viên ngọc của tu viện là Nhà thờ Chúa Cứu Thế (1420–1427) – nhà thờ bằng đá trắng cổ nhất còn nguyên vẹn ở Moskva, với dáng vươn cao thanh thoát rất đặc trưng của kiến trúc Nga sơ kỳ. Chính tại đây, danh họa vẽ thánh tượng vĩ đại Andrei Rublev từng tu hành và, theo truyền thống, được an táng; ông cũng để lại những bích họa nay gần như đã phai mờ theo thời gian. Từ năm 1985, khuôn viên trở thành Bảo tàng Trung ương về Văn hóa và Nghệ thuật Nga cổ mang tên Rublev, nơi trưng bày bộ sưu tập thánh tượng (icon), thủ bản và mỹ thuật trung cổ vào loại quý giá bậc nhất nước Nga. Dạo giữa bãi cỏ xanh mướt, những khóm hoa và các bức tường cổ, du khách vừa chạm vào cội nguồn hội họa thánh của Chính thống giáo, vừa tìm thấy một góc trầm mặc hiếm hoi giữa Moskva hối hả.", "highlights_vi": ["Nhà thờ Chúa Cứu Thế (1420–1427) – công trình bằng đá cổ nhất còn lại của Moskva.", "Nơi gắn với cuộc đời và tương truyền là chốn an nghỉ của danh họa thánh tượng Andrei Rublev.", "Bảo tàng Andrei Rublev với bộ sưu tập thánh tượng và mỹ thuật Nga cổ hàng đầu."], "practical": {"hours_vi": "Khuôn viên tu viện mở cửa hằng ngày và miễn phí; Bảo tàng Rublev mở cửa Thứ Hai, Ba, Sáu 11:00–19:00, Thứ Năm 13:00–21:00, Thứ Bảy 11:00–19:00, Chủ nhật 11:00–18:00, đóng cửa Thứ Tư.", "ticket_vi": "Vào khuôn viên miễn phí; vé bảo tàng khoảng 450 RUB (trẻ 7–17 tuổi 50 RUB, dưới 6 tuổi miễn phí).", "duration_vi": "Khoảng 1,5–2 giờ nếu tham quan cả bảo tàng.", "best_time_vi": "Buổi sáng các ngày bảo tàng mở cửa; tránh Thứ Tư vì bảo tàng đóng.", "tips_vi": "Nếu yêu thích hội họa thánh tượng, hãy dành thời gian cho bảo tàng và cân nhắc thuê audio guide tiếng Anh."}, "photo": "https://commons.wikimedia.org/wiki/Special:FilePath/Andronikov%20Monastery%20%281%29.jpg", "photo_credit": "Wikimedia Commons", "maps": {"yandex": "https://yandex.com/maps/?pt=37.67056,55.74889&z=17&l=map", "google": "https://www.google.com/maps/search/?api=1&query=55.74889,37.67056"}, "official_site": "https://rublev-museum.ru/", "sources": [{"title": "Wikipedia (EN)", "url": "https://en.wikipedia.org/wiki/Special:Search?search=Andronikov%20Monastery%20%28Andrei%20Rublev%20Museum%20of%20Old%20Russian%20Art%29"}], "tags": ["church", "museum", "monastery", "orthodox", "art", "history"], "status": "enriched", "last_updated": "2026-07-16"}, {"id": "moscow-yelokhovo-cathedral", "slug": "yelokhovo-cathedral", "region": "moscow", "region_name_vi": "Moskva", "federal_district": "Thành phố trực thuộc liên bang", "name_vi": "Nhà thờ chính tòa Hiển Linh Yelokhovo (Ê-lô-khô-vô)", "name_ru": "Богоявленский собор в Елохове", "name_en": "Yelokhovo Cathedral (Epiphany Cathedral)", "categories": ["church"], "coordinates": {"lat": 55.7725, "lon": 37.67444}, "address_vi": "Phố Spartakovskaya 15, Moskva, Nga", "rating": {"value": 4.6, "count": 71, "source": "Tripadvisor", "as_of": "2026-07"}, "review_summary_vi": "Đạt 4,6/5 trên Tripadvisor, du khách trầm trồ trước nội thất rực rỡ, bầu không khí cầu nguyện ấm áp và bề dày lịch sử của nhà thờ. Một số phàn nàn về thái độ phục vụ ở quầy bán đồ lưu niệm và việc cấm chụp ảnh bên trong.", "presentation_short_vi": "Nhà thờ Hiển Linh ở Yelokhovo là thánh đường tráng lệ theo phong cách Đế chế muộn, hoàn thành năm 1845. Nơi đây từng là nhà thờ chính tòa của các Thượng phụ Moskva suốt thời Xô Viết và là nơi thi hào Pushkin được rửa tội.", "presentation_long_vi": "Vươn lên với những mái vòm xanh thẫm giữa khu Basmanny, Nhà thờ chính tòa Hiển Linh ở Yelokhovo là một trong những thánh đường bề thế và được yêu mến nhất Moskva. Ngôi nhà thờ hiện nay được kiến trúc sư Yevgraf Tyurin dựng trong các năm 1837–1845 theo phong cách Đế chế muộn, thay cho nhà thờ cũ có từ đầu thế kỷ 18. Không gian bên trong rộng thoáng, chan hòa ánh sáng, dát vàng lộng lẫy và ngập tràn thánh tượng, khiến nhiều tín hữu gọi đây là chốn cầu nguyện ấm áp và choáng ngợp. Yelokhovo còn nặng trĩu ký ức lịch sử: chính tại nơi đây, thi hào Aleksandr Pushkin đã được rửa tội vào năm 1799. Trong những thập niên khắc nghiệt của thời Xô Viết, khi nhiều thánh đường lớn bị đóng cửa, nhà thờ đảm nhận vai trò nhà thờ chính tòa của các Thượng phụ Moskva, chứng kiến lễ tấn phong của nhiều vị đứng đầu Giáo hội. Nơi đây cũng lưu giữ thánh tích của Thánh Aleksy và phần mộ Thượng phụ Aleksy II. Với sự hòa quyện giữa vẻ tráng lệ kiến trúc và tầng tầng lịch sử, Yelokhovo là điểm dừng chân đáng nhớ cho ai muốn hiểu tâm hồn Chính thống giáo Nga.", "highlights_vi": ["Thánh đường phong cách Đế chế muộn (1837–1845) với những mái vòm xanh đặc trưng.", "Nơi thi hào Aleksandr Pushkin được rửa tội năm 1799.", "Nhà thờ chính tòa của các Thượng phụ Moskva suốt phần lớn thời Xô Viết."], "practical": {"hours_vi": "Mở cửa hằng ngày, khoảng 7:00–19:00; lễ sáng và chiều theo lịch phụng vụ.", "ticket_vi": "Miễn phí.", "duration_vi": "Khoảng 30–45 phút.", "best_time_vi": "Sáng sớm hoặc trong giờ lễ để nghe hợp xướng nhà thờ.", "tips_vi": "Ăn mặc kín đáo, nữ trùm khăn đầu; không chụp ảnh trong thánh đường và giữ yên lặng trong giờ lễ."}, "photo": "https://commons.wikimedia.org/wiki/Special:FilePath/Bogoyavlensky%20%28Epiphany%29%20cathedral%20in%20Yelokhovo%2051.jpg", "photo_credit": "Wikimedia Commons", "maps": {"yandex": "https://yandex.com/maps/?pt=37.67444,55.7725&z=17&l=map", "google": "https://www.google.com/maps/search/?api=1&query=55.7725,37.67444"}, "official_site": "https://elohovosobor.ru/", "sources": [{"title": "Wikipedia (EN)", "url": "https://en.wikipedia.org/wiki/Special:Search?search=Yelokhovo%20Cathedral%20%28Epiphany%20Cathedral%29"}], "tags": ["church", "cathedral", "orthodox", "free", "history"], "status": "enriched", "last_updated": "2026-07-16"}, {"id": "moscow-krutitsy-metochion", "slug": "krutitsy-metochion", "region": "moscow", "region_name_vi": "Moskva", "federal_district": "Thành phố trực thuộc liên bang", "name_vi": "Khu di tích Krutitsy (Cru-tít-xcôi)", "name_ru": "Крутицкое подворье", "name_en": "Krutitsy Metochion", "categories": ["church", "monument"], "coordinates": {"lat": 55.7275, "lon": 37.65833}, "address_vi": "Phố Krutitskaya 11, quận Tagansky, Moskva, Nga", "rating": {"value": 4.7, "count": 639, "source": "Tripadvisor", "as_of": "2026-07"}, "review_summary_vi": "Với điểm 4,7/5 trên Tripadvisor, du khách mê mẩn cảm giác 'ngược dòng thời gian' giữa kiến trúc gạch men độc đáo và bầu không khí tĩnh mịch. Lời than phiền phổ biến nhất là công cuộc trùng tu vẫn còn dang dở ở một vài hạng mục.", "presentation_short_vi": "Krutitsy là dinh thự cổ của các Giám mục Krutitsy, nổi tiếng với Teremok – cổng tháp phủ gạch men nhiều màu tuyệt đẹp. Đây là một góc Moskva trung cổ hiếm hoi còn sót lại, đẹp như bước ra từ cổ tích.", "presentation_long_vi": "Nép mình trong quận Tagansky, Krutitsy là một trong những góc trung cổ quyến rũ nhất còn sót lại của Moskva. Hình thành từ cuối thế kỷ 13, nơi đây từng là dinh thự của các Giám mục rồi Giáo chủ Krutitsy, và bước vào thời hoàng kim ở thế kỷ 17. Báu vật của quần thể là Teremok – tòa cổng tháp dựng năm 1693–1694, toàn bộ mặt tiền được phủ kín bằng những viên gạch men (izraztsy) nhiều màu do nghệ nhân Stepan Polubes chế tác, lấp lánh như một tấm thảm gốm khổng lồ. Bên cạnh là Nhà thờ Đức Mẹ An Nghỉ hai tầng, dãy hành lang có mái và phủ đệ của vị Giáo chủ. Bị Nữ hoàng Ekaterina II giải thể năm 1785, Krutitsy sau đó biến thành doanh trại quân đội rồi nhà giam – nơi văn hào Herzen từng bị giam giữ. Ngày nay, đi trên những con hẻm lát đá quanh co, giữa các bức tường gạch đỏ và ô cửa cổ kính, du khách như lạc về nước Nga của mấy trăm năm trước. Chẳng trách nơi đây là phim trường và điểm chụp ảnh được giới nhiếp ảnh Moskva say mê.", "highlights_vi": ["Teremok – cổng tháp thế kỷ 17 phủ kín gạch men nhiều màu rực rỡ.", "Một trong những góc phố trung cổ nguyên vẹn và giàu chất thơ nhất Moskva.", "Từng là dinh của các Giáo chủ Krutitsy và về sau là nhà giam nổi tiếng."], "practical": {"hours_vi": "Khuôn viên ngoài trời mở cửa hằng ngày và tự do dạo bước; các nhà thờ mở theo giờ lễ.", "ticket_vi": "Miễn phí (một số tour có hướng dẫn hoặc hoạt động bảo tàng có thể thu phí).", "duration_vi": "Khoảng 45 phút–1 giờ.", "best_time_vi": "Sáng sớm hoặc chiều muộn để có ánh sáng đẹp chụp ảnh và ít người.", "tips_vi": "Đây là thiên đường cho người mê nhiếp ảnh – hãy để ý những mảng gạch men trên Teremok; nên đi giày thoải mái vì đường lát đá gồ ghề."}, "photo": "https://commons.wikimedia.org/wiki/Special:FilePath/Krutitskoe%20podvorie%20by%20shakko%2001.jpg", "photo_credit": "Wikimedia Commons", "maps": {"yandex": "https://yandex.com/maps/?pt=37.65833,55.7275&z=17&l=map", "google": "https://www.google.com/maps/search/?api=1&query=55.7275,37.65833"}, "official_site": "https://krutitsy.moscow/", "sources": [{"title": "Wikipedia (EN)", "url": "https://en.wikipedia.org/wiki/Special:Search?search=Krutitsy%20Metochion"}], "tags": ["church", "monument", "orthodox", "free", "history", "architecture"], "status": "enriched", "last_updated": "2026-07-16"}, {"id": "moscow-vysokopetrovsky-monastery", "slug": "vysokopetrovsky-monastery", "region": "moscow", "region_name_vi": "Moskva", "federal_district": "Thành phố trực thuộc liên bang", "name_vi": "Tu viện Vysokopetrovsky (Vư-xô-cô-Pê-trốp-xki)", "name_ru": "Высоко-Петровский монастырь", "name_en": "Vysokopetrovsky Monastery", "categories": ["church"], "coordinates": {"lat": 55.76722, "lon": 37.615}, "address_vi": "Phố Petrovka 28/2, Moskva, Nga", "rating": {"value": 4.7, "count": 106, "source": "Tripadvisor", "as_of": "2026-07"}, "review_summary_vi": "Với 4,7/5 trên Tripadvisor, du khách yêu thích sự tĩnh lặng, kiến trúc đa dạng qua nhiều thế kỷ và món ăn ngon, giá phải chăng ở nhà ăn tu viện. Một số cho biết vài khu vực bị hạn chế do đang trùng tu.", "presentation_short_vi": "Tu viện Vysokopetrovsky là một quần thể baroque duyên dáng ngay trung tâm Moskva, khởi lập từ đầu thế kỷ 14 và gắn với tên Thánh Pyotr – vị Giáo trưởng đầu tiên của Moskva. Chính tu viện đã đặt tên cho con phố Petrovka nổi tiếng.", "presentation_long_vi": "Giữa nhịp sống sôi động của phố Petrovka, Tu viện Vysokopetrovsky mở ra một ốc đảo bình yên với những mái vòm đỏ và bức tường trắng duyên dáng. Tu viện được cho là hình thành vào khoảng thập niên 1310 và mang tên Thánh Pyotr – vị Giáo trưởng đầu tiên chọn Moskva làm tòa giám mục. Trái tim của quần thể là Nhà thờ Thánh Pyotr (1517), do kiến trúc sư người Ý Aleviz Novy thiết kế với mặt bằng hình cánh hoa vô cùng độc đáo, hiếm gặp trong kiến trúc Nga. Vào cuối thế kỷ 17, dưới sự bảo trợ của dòng họ Naryshkin – thân tộc bên ngoại của Pyotr Đại đế – tu viện được mở rộng lộng lẫy theo phong cách 'baroque Naryshkin', với Nhà thờ Đức Mẹ Bogolyubovo, nhà thờ - nhà ăn Thánh Sergiy và tháp chuông trên cổng Bảo Trợ. Nhiều thành viên họ Naryshkin cũng an nghỉ tại đây. Trải qua thời Xô Viết bị đóng cửa, ngày nay tu viện đã hồi sinh như một trung tâm hành hương và văn hóa. Chỉ cần bước qua cổng, du khách lập tức rời xa sự ồn ào phố thị để đắm mình trong vẻ trầm mặc và tinh tế của kiến trúc Nga thế kỷ 16–17.", "highlights_vi": ["Nhà thờ Thánh Pyotr (1517) mặt bằng hình cánh hoa độc đáo do Aleviz Novy thiết kế.", "Quần thể 'baroque Naryshkin' gắn với thân tộc của Pyotr Đại đế.", "Ốc đảo yên bình ngay trên phố Petrovka sầm uất ở trung tâm Moskva."], "practical": {"hours_vi": "Mở cửa hằng ngày, khoảng 8:00–20:00; giờ lễ theo lịch phụng vụ.", "ticket_vi": "Miễn phí.", "duration_vi": "Khoảng 45 phút–1 giờ.", "best_time_vi": "Ngày thường, kết hợp dạo phố Petrovka và các phố trung tâm.", "tips_vi": "Ghé nhà ăn (trapeznaya) để thử bánh và món chay của tu viện; ăn mặc kín đáo khi vào nhà thờ."}, "photo": "https://commons.wikimedia.org/wiki/Special:FilePath/Vysokopetrovsky%20Monastery%204.JPG", "photo_credit": "Wikimedia Commons", "maps": {"yandex": "https://yandex.com/maps/?pt=37.615,55.76722&z=17&l=map", "google": "https://www.google.com/maps/search/?api=1&query=55.76722,37.615"}, "official_site": "https://vpmon.ru/", "sources": [{"title": "Wikipedia (EN)", "url": "https://en.wikipedia.org/wiki/Special:Search?search=Vysokopetrovsky%20Monastery"}], "tags": ["church", "monastery", "orthodox", "free", "history", "architecture"], "status": "enriched", "last_updated": "2026-07-16"}, {"id": "moscow-novospassky-monastery", "slug": "novospassky-monastery", "region": "moscow", "region_name_vi": "Moskva", "federal_district": "Thành phố trực thuộc liên bang", "name_vi": "Tu viện Novospassky (Nô-vô-xpa-xki)", "name_ru": "Новоспасский монастырь", "name_en": "Novospassky Monastery", "categories": ["church"], "coordinates": {"lat": 55.73194, "lon": 37.65667}, "address_vi": "Quảng trường Krestyanskaya 10, Moskva, Nga", "rating": {"value": 4.6, "count": 237, "source": "Tripadvisor", "as_of": "2026-07"}, "review_summary_vi": "Đạt 4,6/5 trên Tripadvisor, du khách đánh giá cao kiến trúc bề thế, tường thành cổ và bầu không khí trang nghiêm, tĩnh lặng. Một số phản hồi cho biết nhiều khu vực bị đóng hoặc đang trùng tu nên trải nghiệm tham quan có phần hạn chế.", "presentation_short_vi": "Tu viện Novospassky ('Tu viện Chúa Cứu Thế Mới') là một pháo đài tâm linh bên sông Moskva, nổi bật với Nhà thờ Chúa Biến Hình năm mái vòm và tháp chuông cao vút. Đây còn là nơi an nghỉ của nhiều tổ tiên dòng họ Romanov.", "presentation_long_vi": "Sừng sững sau vòng tường thành kiên cố bên tả ngạn sông Moskva, Tu viện Novospassky – nghĩa là 'Tu viện Chúa Cứu Thế Mới' – mang trong mình lịch sử gắn liền với vương triều Romanov. Nguồn gốc của nó ngược về tu viện đầu tiên của Moskva; đến thập niên 1490, Đại công Ivan III cho dời về vị trí hiện nay, tách khỏi tu viện cũ trong Điện Kremlin. Công trình trung tâm là Nhà thờ Chúa Biến Hình (1645–1649) với năm mái vòm uy nghi và những bức bích họa do các họa sư tài danh nhất Moskva thực hiện. Vươn lên bên cạnh là tháp chuông cao thuộc hàng cao nhất thành phố, dựng trong các năm 1759–1785. Nhưng điều khiến Novospassky trở nên đặc biệt là hầm mộ dòng họ Romanov: nơi đây an táng nhiều tổ tiên của vương triều, trong đó có bà Kseniya Shestova – mẹ của Sa hoàng Mikhail đầu tiên – cùng Đại công Sergei Aleksandrovich. Đối với những ai muốn chạm vào cội rễ của triều đại từng trị vì nước Nga suốt hơn ba thế kỷ, tu viện là một điểm đến vừa trang nghiêm vừa thấm đẫm chiều sâu lịch sử.", "highlights_vi": ["Nhà thờ Chúa Biến Hình (1645–1649) năm mái vòm với bích họa quý giá.", "Hầm mộ dòng họ Romanov – nơi an nghỉ của nhiều tổ tiên vương triều.", "Tháp chuông thế kỷ 18 thuộc hàng cao nhất Moskva."], "practical": {"hours_vi": "Mở cửa hằng ngày, khoảng 8:00–20:00; giờ lễ theo lịch phụng vụ.", "ticket_vi": "Miễn phí (tham quan hầm mộ hoặc tour chuyên đề có thể thu phí).", "duration_vi": "Khoảng 1–1,5 giờ.", "best_time_vi": "Sáng ngày thường để tận hưởng sự yên tĩnh và ánh sáng đẹp.", "tips_vi": "Đừng bỏ lỡ tháp chuông và hầm mộ Romanov; mang trang phục kín đáo, nữ trùm khăn đầu."}, "photo": "https://commons.wikimedia.org/wiki/Special:FilePath/Novospassky%20Monastery.jpg", "photo_credit": "Wikimedia Commons", "maps": {"yandex": "https://yandex.com/maps/?pt=37.65667,55.73194&z=17&l=map", "google": "https://www.google.com/maps/search/?api=1&query=55.73194,37.65667"}, "official_site": "https://novospasskiymon.moseparh.ru/", "sources": [{"title": "Wikipedia (EN)", "url": "https://en.wikipedia.org/wiki/Special:Search?search=Novospassky%20Monastery"}], "tags": ["church", "monastery", "orthodox", "free", "history", "romanov"], "status": "enriched", "last_updated": "2026-07-16"}, {"id": "moscow-winzavod", "slug": "winzavod", "region": "moscow", "region_name_vi": "Moskva", "federal_district": "Thành phố trực thuộc liên bang", "name_vi": "Trung tâm Nghệ thuật Đương đại Winzavod (Vin-da-vốt)", "name_ru": "Центр современного искусства «Винзавод»", "name_en": "Winzavod Center for Contemporary Art", "categories": ["museum"], "coordinates": {"lat": 55.755556, "lon": 37.664613}, "address_vi": "Ngõ 4-y Syromyatnichesky (số 1/8), quận Basmanny, Moscow 105120; gần ga tàu điện ngầm Kurskaya/Chkalovskaya.", "rating": {"value": 4.0, "count": 127, "source": "Tripadvisor", "as_of": "2026-07"}, "review_summary_vi": "Với khoảng 4,0/5 trên Tripadvisor (hơn 120 đánh giá), du khách khen kiến trúc công nghiệp độc đáo, các quán xá và không gian sáng tạo. Một số người lại thấy nơi đây khá vắng, vài triển lãm chưa ấn tượng và biển chỉ dẫn chủ yếu bằng tiếng Nga nên hơi khó định hướng.", "presentation_short_vi": "Winzavod là trung tâm nghệ thuật đương đại tư nhân lớn và lâu đời bậc nhất Moscow, cải tạo từ một xưởng bia - rượu vang cuối thế kỷ 19. Quần thể gồm bảy tòa nhà công nghiệp bằng gạch đỏ nay là nơi tập trung các phòng tranh, xưởng sáng tác, quán cà phê và cửa hàng thiết kế.", "presentation_long_vi": "Nằm trong khu Syromyatniki gần ga tàu điện ngầm Kurskaya, Winzavod ra đời năm 2007 trên nền một nhà máy bia mang tên 'Moscow Bavaria', về sau chuyển thành xưởng rượu vang - cái tên 'Vinzavod' (nghĩa là 'nhà máy rượu') cũng bắt nguồn từ đó. Doanh nhân Roman Trotsenko cùng kiến trúc sư Alexander Brodsky đã biến bảy tòa nhà gạch đỏ kiểu công nghiệp thành một trong những cụm nghệ thuật đương đại đầu tiên và có ảnh hưởng nhất nước Nga. Đi giữa những bức tường gạch trần, ống dẫn lộ thiên và khoảng sân rộng, du khách sẽ bắt gặp các phòng tranh danh tiếng, không gian triển lãm luân phiên, studio của nghệ sĩ trẻ, hiệu sách, quán cà phê và cửa hàng thời trang - thiết kế độc lập. Winzavod cũng là nơi tổ chức nhiều liên hoan nhiếp ảnh, hội chợ nghệ thuật và chương trình giáo dục sáng tạo. Không hào nhoáng như bảo tàng chính thống, nơi đây hấp dẫn ở tinh thần phóng khoáng, đậm chất 'khu công nghiệp hồi sinh' và bầu không khí trẻ trung, thử nghiệm. Đây là điểm đến lý tưởng cho những ai muốn cảm nhận nhịp sống nghệ thuật ngầm và văn hóa đô thị hiện đại của Moscow, tách khỏi lối mòn tham quan cung điện và nhà thờ truyền thống.", "highlights_vi": ["Bảy tòa nhà gạch đỏ từ nhà máy rượu vang thế kỷ 19 được cải tạo thành không gian nghệ thuật", "Cụm phòng tranh đương đại, studio nghệ sĩ và các hội chợ - liên hoan nghệ thuật thường xuyên", "Quán cà phê, hiệu sách và cửa hàng thiết kế độc lập trong bầu không khí công nghiệp trẻ trung"], "practical": {"hours_vi": "Khuôn viên mở cửa hằng ngày 10:00–23:00; các phòng tranh và triển lãm mở thứ Ba–Chủ Nhật 12:00–20:00, đóng cửa thứ Hai.", "ticket_vi": "Vào khuôn viên miễn phí; một số triển lãm miễn phí, số khác thu vé tùy sự kiện (có thể lên tới khoảng 2.500 RUB).", "duration_vi": "Khoảng 1,5–2 giờ.", "best_time_vi": "Chiều muộn cuối tuần khi các phòng tranh, quán cà phê và sự kiện đều nhộn nhịp.", "tips_vi": "Kiểm tra lịch triển lãm trên website trước khi đến vì nhiều không gian đóng/mở theo sự kiện; ga gần nhất là Kurskaya hoặc Chkalovskaya."}, "photo": null, "photo_credit": null, "maps": {"yandex": "https://yandex.com/maps/?pt=37.664613,55.755556&z=17&l=map", "google": "https://www.google.com/maps/search/?api=1&query=55.755556,37.664613"}, "official_site": "https://www.winzavod.ru", "sources": [{"title": "Wikipedia (EN)", "url": "https://en.wikipedia.org/wiki/Special:Search?search=Winzavod%20Center%20for%20Contemporary%20Art"}], "tags": ["museum", "art", "modern", "contemporary-art", "gallery"], "status": "enriched", "last_updated": "2026-07-16"}, {"id": "moscow-moscow-planetarium", "slug": "moscow-planetarium", "region": "moscow", "region_name_vi": "Moskva", "federal_district": "Thành phố trực thuộc liên bang", "name_vi": "Cung Thiên văn Moscow (Mát-xcốp-xki Pla-nê-ta-ri)", "name_ru": "Московский планетарий", "name_en": "Moscow Planetarium", "categories": ["museum"], "coordinates": {"lat": 55.761389, "lon": 37.583611}, "address_vi": "Phố Sadovaya-Kudrinskaya, số 5, Moscow 123242; gần ga tàu điện ngầm Barrikadnaya.", "rating": {"value": 4.2, "count": 970, "source": "Tripadvisor", "as_of": "2026-07"}, "review_summary_vi": "Đạt khoảng 4,2/5 trên Tripadvisor (gần 1.000 đánh giá), du khách đặc biệt thích chương trình vòm 'Copernicus', ghế ngả êm và giá trị giáo dục của các khu trưng bày. Một vài ý kiến phàn nàn về việc một số sảnh chỉ vào được khi mua suất chiếu và đôi lúc khâu tổ chức chưa mượt.", "presentation_short_vi": "Cung Thiên văn Moscow là cung thiên văn lâu đời nhất nước Nga, khai trương năm 1929 và hồi sinh ngoạn mục sau đợt đại trùng tu kéo dài đến năm 2011. Mái vòm chiếu sao đường kính 25 m cùng hệ thống bảo tàng tương tác biến nơi đây thành điểm khám phá vũ trụ hấp dẫn cho mọi lứa tuổi.", "presentation_long_vi": "Tọa lạc trên phố Sadovaya-Kudrinskaya gần ga Barrikadnaya, Cung Thiên văn Moscow mở cửa từ năm 1929 và là một trong những cung thiên văn cổ nhất thế giới còn hoạt động. Trong đợt trùng tu quy mô lớn, toàn bộ tòa nhà lịch sử được nâng cao vài mét để chèn thêm các tầng bên dưới mái vòm, giúp mở rộng không gian trưng bày mà vẫn giữ được diện mạo kiến trúc kiến tạo (constructivism) đặc trưng thập niên 1920. Trái tim của cung là Đại sảnh Sao với màn vòm 25 m, nơi trình chiếu những chương trình về hệ Mặt Trời và bầu trời đêm, có suất kết hợp cả diễn viên, xiếc và kể chuyện khoa học. Bên cạnh đó là Bảo tàng Urania trưng bày thiên thạch và lịch sử khám phá vũ trụ, khu tương tác Lunarium với hàng chục mô hình thí nghiệm, rạp 4D, đài quan sát và các sảnh chiếu nhỏ. Đây là điểm đến được các gia đình và bạn trẻ yêu thích, vừa mang tính giải trí vừa giàu kiến thức. Ghế ngả thoải mái để ngước nhìn vòm sao, nhiều suất chiếu có phụ đề đa ngôn ngữ, cùng bầu không khí vừa hoài niệm vừa hiện đại khiến chuyến tham quan trở nên đáng nhớ với bất kỳ ai mê thiên văn.", "highlights_vi": ["Đại sảnh Sao v